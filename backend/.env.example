APP_NAME=Booking Platform API
# development | test | production. Production refuses to start with unsafe settings (see core/config.py).
APP_ENV=development
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5433/booking_platform
APP_VERSION=1.0.0

# REQUIRED in production: a random value of at least 32 characters, e.g. `openssl rand -hex 32`.
TOKEN_SECRET_KEY=change-me-for-production
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14

# REQUIRED in production: Fernet key(s), newest first, that encrypt stored processor and ad-platform secrets.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_SECRETS_KEY=

# Demo business and owner login. Defaults to on in development/test and off in production.
# SEED_DEMO_DATA=false

# REQUIRED in production (16+ characters): the invite code needed to create a business. Hand it only to
# businesses you are onboarding; they enter it on the onboarding page. Empty keeps local signup open.
PLATFORM_ADMIN_TOKEN=

# Must NOT be set in production.
# TEST_RESET_TOKEN=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
RESEND_API_BASE_URL=https://api.resend.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_API_BASE_URL=https://api.stripe.com/v1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CLOVER_APP_ID=
CLOVER_APP_SECRET=
# sandbox | production (never "fake" in production)
CLOVER_ENVIRONMENT=sandbox

# Public URLs used in customer emails and links. Must not point at localhost in production.
STOREFRONT_PUBLIC_BASE_URL=http://localhost:3001
DASHBOARD_PUBLIC_BASE_URL=http://localhost:5173
MEDIA_BASE_URL=http://localhost:8000/api/v1/forms/files
MEDIA_ROOT=/media
# Comma-separated; production must list only your real dashboard and storefront origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
