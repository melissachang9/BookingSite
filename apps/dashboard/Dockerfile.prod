FROM node:20-alpine AS build

WORKDIR /app

COPY package.json ./package.json
COPY package-lock.json ./package-lock.json
COPY apps/dashboard/package.json ./apps/dashboard/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json
RUN npm ci

COPY apps/dashboard ./apps/dashboard
COPY packages/api-client ./packages/api-client
COPY packages/shared-types ./packages/shared-types

# Vite inlines these at build time.
ARG VITE_PUBLIC_API_BASE_URL
ARG VITE_PUBLIC_STOREFRONT_BASE_URL
ENV VITE_PUBLIC_API_BASE_URL=$VITE_PUBLIC_API_BASE_URL
ENV VITE_PUBLIC_STOREFRONT_BASE_URL=$VITE_PUBLIC_STOREFRONT_BASE_URL
ENV NODE_OPTIONS="--max-old-space-size=4096"

WORKDIR /app/apps/dashboard
RUN npm run build

FROM caddy:2-alpine
COPY apps/dashboard/Caddyfile.static /etc/caddy/Caddyfile
COPY --from=build /app/apps/dashboard/dist /srv
EXPOSE 80
